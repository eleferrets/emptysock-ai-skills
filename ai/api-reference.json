      }
    },
    "ParticleEmitter": {
      "import": "import { ParticleEmitter } from '@emptysock/engine'",
      "description": "Component that spawns and animates short-lived visual particles. Attach to an entity, configure options, then call start() or burst().",
      "constructorOptions": {
        "rate": "number \u2014 particles emitted per second in continuous mode",
        "lifetime": "number \u2014 seconds each particle lives",
        "speed": "number \u2014 initial speed in world units/second",
        "spread": "number \u2014 emission cone half-angle in degrees (0 = straight line, 360 = sphere)",
        "count": "number (1\u20132000) \u2014 maximum simultaneous live particles",
        "textureName": "string (optional) \u2014 asset name for sprite-sheet particles; omit for default white square"
      },
      "methods": {
        "start": "emitter.start(): void \u2014 begin continuous emission at the configured rate",
        "stop": "emitter.stop(): void \u2014 stop emitting new particles; existing particles finish their lifetime",
        "burst": "emitter.burst(count: number): void \u2014 fire exactly count particles immediately, ignoring rate"
      },
      "properties": {
        "rate": "number \u2014 read/write, effective before start() is called",
        "lifetime": "number \u2014 read/write",
        "speed": "number \u2014 read/write",
        "spread": "number \u2014 read/write",
        "count": "number \u2014 read/write",
        "textureName": "string | undefined \u2014 read/write"
      },
      "notes": [
        "Call stop() in onDestroy before the entity is destroyed.",
        "burst() does not require start() to have been called first.",
        "Particles sharing the same textureName are batched into one draw call.",
        "count should be kept as low as visually acceptable \u2014 all particles update every frame."
      ]
    },
    "WindowSystem": {
      "description": "Manages window mode, size, title, and position. Wraps Tauri native window API with transparent browser fallback. Import the singleton `windowSystem`.",
      "import": "import { windowSystem, type WindowMode, type WindowConfig } from '@emptysock/engine'",
      "methods": {
        "apply": {
          "signature": "apply(config: Partial<WindowConfig>): Promise<void>",
          "description": "Apply all window settings at once. Call once in root scene onLoad."
        },
        "setMode": {
          "signature": "setMode(mode: WindowMode): Promise<void>",
          "description": "Switch window mode. 'windowed' | 'fullscreen' | 'borderless'."
        },
        "setSize": {
          "signature": "setSize(width: number, height: number): Promise<void>",
          "description": "Resize the window. No-op in fullscreen/borderless modes on desktop."
        },
        "setTitle": {
          "signature": "setTitle(title: string): Promise<void>",
          "description": "Update the window/tab title."
        },
        "setResizable": {
          "signature": "setResizable(resizable: boolean): Promise<void>",
          "description": "Allow or prevent manual resizing. Desktop only."
        },
        "setMinSize": {
          "signature": "setMinSize(width: number, height: number): Promise<void>",
          "description": "Set minimum window dimensions. Desktop only."
        },
        "setPosition": {
          "signature": "setPosition(x: number, y: number): Promise<void>",
          "description": "Move window to screen coordinates. Desktop only."
        },
        "center": {
          "signature": "center(): Promise<void>",
          "description": "Centre window on the current monitor. Desktop only."
        },
        "setAlwaysOnTop": {
