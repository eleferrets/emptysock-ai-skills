        "disableAutoSave": "SaveSystem.disableAutoSave(): void"
      },
      "SaveSlot": {
        "slot": "string",
        "data": "unknown \u2014 ALWAYS parse through Zod before use",
        "timestamp": "number",
        "playtime": "number \u2014 seconds",
        "scene": "string"
      },
      "settings": {
        "get": "SaveSystem.settings.get<T>(key: string): T | undefined",
        "set": "SaveSystem.settings.set(key: string, value: unknown): Promise<void>"
      }
    },
    "LocalisationSystem": {
      "import": "import { t, LocalisationSystem } from '@emptysock/engine'",
      "methods": {
        "t": "t(key: string, vars?: Record<string, string | number>): string",
        "setLocale": "LocalisationSystem.setLocale(code: string): void",
        "getLocale": "LocalisationSystem.getLocale(): string",
        "hasKey": "LocalisationSystem.hasKey(key: string): boolean",
        "availableLocales": "LocalisationSystem.availableLocales: string[]"
      },
      "translationFileFormat": {
        "location": "assets/i18n/[locale].json",
        "example": {
          "menu.start": "Start Game",
          "hud.score": "Score: {{score}}",
          "hud.lives": "{{count}} lives"
        }
      }
    },
    "PathfindingSystem": {
      "import": "import { PathfindingSystem } from '@emptysock/engine'",
