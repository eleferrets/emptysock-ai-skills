{
  "meta": {
    "engine": "EmptySock",
    "version": "1.0.0",
    "package": "@emptysock/engine",
    "description": "Machine-readable public API reference. Load at agent task start for full typed context. No internal implementation details.",
    "repo": "https://github.com/your-org/emptysock-agent-pack"
  },
  "stack": {
    "renderer2d": "PixiJS v8 (WebGL2 primary, WebGPU where available)",
    "renderer3d": "Three.js (optional, hybrid scenes only)",
    "physics": "Rapier2D WASM (@dimforge/rapier2d)",
    "audio": "Howler.js",
    "shell": "Tauri v2",
    "language": "TypeScript strict mode"
  },
  "rules": {
    "banned_imports": [
      "pixi.js",
      "@dimforge/rapier2d",
      "howler",
      "three"
    ],
    "banned_patterns": [
      "any type",
      "non-null assertion (!)",
      "ts-ignore",
      "setTimeout in game logic",
      "setInterval in game logic",
      "async onUpdate()",
      "await inside onUpdate()",
      "document.querySelector",
      "document.getElementById",
      "JSON.parse(x) as T \u2014 always use Zod",
      "window.localStorage \u2014 use SaveSystem"
    ],
    "required_patterns": [
      "explicit return types on all functions",
      "import type for type-only imports",
      "Zod schema for all external data",
      "entity.destroy() when entity is done",
      "TimerHandle.cancel() in onDestroy()",
      "conventional commits: feat/fix/refactor/chore(scope): message"
    ]
  },
  "systems": {
    "Engine": {
      "import": "import { Engine } from '@emptysock/engine'",
      "methods": {
        "create": {
          "signature": "Engine.create(config: EngineConfig): Promise<Engine>",
          "config": {
            "scenes": "Record<string, typeof Scene> \u2014 all scene classes",
            "startScene": "string \u2014 name of first scene to load",
            "gameSpeed": "number \u2014 target FPS, default 60",
            "rendererType": "'auto' | 'webgpu' | 'webgl2' \u2014 default 'auto'",
            "splash": "boolean \u2014 show splash on boot, default false"
          }
        },
        "start": "engine.start(): Promise<void>",
        "stop": "engine.stop(): void"
      },
      "properties": {
        "gpuTier": "'potato' | 'low' | 'mid' | 'high' | 'ultra' \u2014 read-only"
      }
    },
    "Scene": {
      "import": "import { Scene, type SceneConfig } from '@emptysock/engine'",
      "description": "Base class. Extend for every game scene.",
      "static": {
        "config": "SceneConfig \u2014 declare as static readonly on each subclass"
      },
      "SceneConfig": {
        "renderMode": "'2d' | '3d' | 'hybrid'",
        "gameSpeed": "number \u2014 overrides engine default for this scene",
        "physics": "boolean \u2014 enable Rapier world, default true",
        "lighting": "boolean \u2014 enable 2D lighting pass, default false",
        "backgroundColor": "number \u2014 hex colour"
      },
      "lifecycle": {
        "onLoad": "async onLoad(): Promise<void> \u2014 awaited before scene renders",
        "onStart": "onStart(): void \u2014 called once after onLoad",
        "onUpdate": "onUpdate(dt: number): void \u2014 every frame, dt = seconds",
        "onFixedUpdate": "onFixedUpdate(dt: number): void \u2014 fixed 1/60s timestep",
        "onDestroy": "onDestroy(): void \u2014 before scene unloads",
        "onPause": "onPause(): void \u2014 when scene is pushed under another",
        "onResume": "onResume(): void \u2014 when scene returns to top"
      },
      "methods": {
        "createEntity": "scene.createEntity(name: string, opts?: { position?: Point, rotation?: number, scale?: Point }): Entity",
        "getEntity": "scene.getEntity(name: string): Entity | undefined",
        "getEntitiesByTag": "scene.getEntitiesByTag(tag: string): Entity[]",
        "getEntitiesWithComponent": "scene.getEntitiesWithComponent(type: ComponentType): Entity[]",
        "instantiatePrefab": "scene.instantiatePrefab(file: string, opts?: PrefabOptions): Entity",
        "createParticleEmitter": "scene.createParticleEmitter(opts: ParticleEmitterOptions): ParticleEmitter"
      },
      "properties": {
        "lighting.ambientColour": "number (hex)",
        "lighting.ambientIntensity": "number (0\u20131)",
        "postProcess": {
          "add": "scene.postProcess.add(effect: PostEffect, opts?: object): void",
          "remove": "scene.postProcess.remove(effect: PostEffect): void",
          "flash": "scene.postProcess.flash(opts: FlashOptions): void"
        }
      }
    },
    "SceneManager": {
      "import": "import { SceneManager } from '@emptysock/engine'",
      "methods": {
        "load": "SceneManager.load(name: string, opts?: LoadOptions): Promise<void>",
        "transition": "SceneManager.transition(name: string, opts: TransitionOptions): Promise<void>",
        "push": "SceneManager.push(name: string): Promise<void>",
        "pop": "SceneManager.pop(): Promise<void>",
        "preload": "SceneManager.preload(name: string): Promise<void>"
      },
      "properties": {
        "currentScene": "string \u2014 name of active scene"
      },
      "TransitionOptions": {
        "effect": "'fade' | 'wipe' | 'iris' | 'slide' | 'zoom' | 'dissolve' | 'flash' | 'custom'",
        "duration": "number (seconds)",
        "colour": "number (hex, for fade/flash)",
        "direction": "'left' | 'right' | 'up' | 'down' (for wipe/slide)",
        "origin": "Point (for iris/zoom)"
      }
    },
    "Entity": {
      "import": "import { Entity } from '@emptysock/engine'",
      "properties": {
        "name": "string",
        "position": "{ x: number, y: number }",
        "globalPosition": "{ x: number, y: number } \u2014 world-space",
        "rotation": "number \u2014 radians",
        "rotationDegrees": "number",
        "scale": "{ x: number, y: number }",
        "active": "boolean",
        "isAlive": "boolean"
      },
      "methods": {
        "addComponent": "entity.addComponent<T>(type: new() => T, props?: Partial<T>): T",
        "getComponent": "entity.getComponent<T>(type: new() => T): T | undefined",
        "requireComponent": "entity.requireComponent<T>(type: new() => T): T",
        "hasComponent": "entity.hasComponent(type: ComponentType): boolean",
        "removeComponent": "entity.removeComponent(type: ComponentType): void",
        "addTag": "entity.addTag(tag: string): void",
        "removeTag": "entity.removeTag(tag: string): void",
        "hasTag": "entity.hasTag(tag: string): boolean",
        "setParent": "entity.setParent(parent: Entity | null): void",
        "setPosition": "entity.setPosition(x: number, y: number): void",
        "translate": "entity.translate(dx: number, dy: number): void",
        "rotateTo": "entity.rotateTo(radians: number, opts?: TweenOptions): void",
        "distanceTo": "entity.distanceTo(other: Entity): number",
        "angleTo": "entity.angleTo(other: Entity): number",
        "destroy": "entity.destroy(): void",
        "emit": "entity.emit(event: string, data?: unknown): void",
        "on": "entity.on(event: string, fn: (data: unknown) => void): void",
        "once": "entity.once(event: string, fn: (data: unknown) => void): void",
        "off": "entity.off(event: string, fn: Function): void",
        "onCollisionEnter": "entity.onCollisionEnter(fn: (other: Entity, contact: ContactInfo) => void): void",
        "onCollisionExit": "entity.onCollisionExit(fn: (other: Entity) => void): void",
        "onSensorEnter": "entity.onSensorEnter(fn: (other: Entity) => void): void",
        "onSensorExit": "entity.onSensorExit(fn: (other: Entity) => void): void",
        "startCoroutine": "entity.startCoroutine(gen: GeneratorFunction, name?: string): void",
        "stopCoroutine": "entity.stopCoroutine(name: string): void"
      }
    },
    "components": {
      "Sprite": {
        "import": "import { Sprite } from '@emptysock/engine'",
        "props": {
          "texture": "string \u2014 filename in assets/sprites/",
          "frame": "string \u2014 atlas frame name (optional)",
          "anchor": "{ x: number, y: number } \u2014 0\u20131, default { x: 0.5, y: 0.5 }",
          "tint": "number \u2014 hex, default 0xffffff",
          "alpha": "number \u2014 0\u20131",
          "blendMode": "'normal' | 'add' | 'multiply' | 'screen'",
          "flipX": "boolean",
          "flipY": "boolean",
          "normalMap": "string \u2014 filename for 2D lighting normal map (optional)"
        }
      },
      "Animator": {
        "import": "import { Animator } from '@emptysock/engine'",
        "props": {
          "spritesheet": "string \u2014 .esanim file",
          "defaultClip": "string \u2014 animation name to play on attach",
          "speed": "number \u2014 playback multiplier, default 1"
        },
        "methods": {
          "play": "animator.play(clip: string, opts?: { loop?: boolean, onComplete?: () => void }): void",
          "pause": "animator.pause(): void",
          "resume": "animator.resume(): void",
          "stop": "animator.stop(): void"
        },
        "properties": {
          "currentClip": "string",
          "currentFrame": "number",
          "isPlaying": "boolean"
        }
      },
      "PhysicsBody": {
        "import": "import { PhysicsBody } from '@emptysock/engine'",
        "props": {
          "shape": "'cuboid' | 'ball' | 'capsule' | 'polygon' | 'compound'",
          "bodyType": "'fixed' | 'dynamic' | 'kinematicPosition' | 'kinematicVelocity'",
          "mass": "number",
          "friction": "number \u2014 0\u20131",
          "restitution": "number \u2014 0\u20131 (bounciness)",
          "ccd": "boolean \u2014 continuous collision detection, for fast objects",
          "sensor": "boolean \u2014 trigger volume, no physical response",
          "collisionGroups": "string[] \u2014 named group labels"
        },
        "methods": {
          "applyImpulse": "body.applyImpulse(force: Vector2): void",
          "applyForce": "body.applyForce(force: Vector2): void",
          "setVelocity": "body.setVelocity(vel: Vector2): void",
          "getVelocity": "body.getVelocity(): Vector2"
        }
      },
      "CharacterController": {
        "import": "import { CharacterController } from '@emptysock/engine'",
        "props": {
          "slopeAngle": "number \u2014 max walkable slope degrees",
          "snapToGround": "number \u2014 snap distance (0 = off)",
          "offset": "number \u2014 collision skin width, default 0.01"
        },
        "methods": {
          "moveAndSlide": "controller.moveAndSlide(velocity: Vector2): void",
          "isGrounded": "controller.isGrounded(): boolean",
          "isTouchingCeiling": "controller.isTouchingCeiling(): boolean",
          "isTouchingWall": "controller.isTouchingWall(): 'left' | 'right' | null"
        }
      },
      "PointLight": {
        "import": "import { PointLight } from '@emptysock/engine'",
        "note": "Requires scene config lighting: true",
        "props": {
          "colour": "number \u2014 hex",
          "intensity": "number",
          "radius": "number \u2014 pixels",
          "castShadows": "boolean"
        }
      },
      "DirectionalLight": {
        "import": "import { DirectionalLight } from '@emptysock/engine'",
        "props": {
          "colour": "number",
          "intensity": "number",
          "angle": "number \u2014 radians",
          "castShadows": "boolean"
        }
      },
      "SpotLight": {
        "import": "import { SpotLight } from '@emptysock/engine'",
        "props": {
          "colour": "number",
          "intensity": "number",
          "radius": "number",
          "innerAngle": "number",
          "outerAngle": "number",
          "castShadows": "boolean"
        }
      },
      "PathFollower": {
        "import": "import { PathFollower } from '@emptysock/engine'",
        "props": {
          "path": "Path",
          "speed": "number",
          "onComplete": "() => void \u2014 optional"
        },
        "methods": {
          "setPath": "follower.setPath(path: Path): void",
          "stop": "follower.stop(): void",
          "resume": "follower.resume(): void",
          "isComplete": "follower.isComplete(): boolean"
        }
      },
      "VNController": {
        "import": "import { VNController } from '@emptysock/engine'",
        "props": {
          "dialogueTree": "string \u2014 .esvn file",
          "onChoice": "(index: number, text: string) => void",
          "onEvent": "(name: string, data: unknown) => void"
        },
        "methods": {
          "advance": "vn.advance(): void",
          "jump": "vn.jump(nodeId: string): void",
          "isFinished": "vn.isFinished(): boolean"
        }
      }
    },
    "Input": {
      "import": "import { Input } from '@emptysock/engine'",
      "methods": {
        "isDown": "Input.isDown(key: string): boolean \u2014 held",
        "isPressed": "Input.isPressed(key: string): boolean \u2014 just pressed",
        "isReleased": "Input.isReleased(key: string): boolean \u2014 just released",
        "axis": "Input.axis(name: 'Horizontal' | 'Vertical' | string): number \u2014 -1 to 1",
        "onKeyDown": "Input.onKeyDown(key: string, fn: () => void): void",
        "rumble": "Input.rumble(gamepad: string, opts: { intensity: number, duration: number }): void",
        "vibrate": "Input.vibrate(ms: number): void"
      },
      "properties": {
        "pointer.position": "{ x: number, y: number }",
        "pointer.isDown": "boolean",
        "pointer.isPressed": "boolean",
        "touches": "Touch[]"
      },
      "keyNames": "ArrowLeft ArrowRight ArrowUp ArrowDown Space Enter Escape KeyA-Z Digit0-9 gamepad0/A gamepad0/B gamepad0/X gamepad0/Y gamepad0/L1 gamepad0/R1 gamepad0/L2 gamepad0/R2 gamepad0/DPadLeft gamepad0/DPadRight gamepad0/DPadUp gamepad0/DPadDown gamepad0/Start gamepad0/Select"
    },
    "Audio": {
      "import": "import { Audio } from '@emptysock/engine'",
      "methods": {
        "play": "Audio.play(id: string, opts?: PlayOptions): AudioHandle",
        "music": "Audio.music(id: string, opts?: MusicOptions): void",
        "stopMusic": "Audio.stopMusic(opts?: { fade?: number }): void",
        "stop": "Audio.stop(id: string): void",
        "setGroupVolume": "Audio.setGroupVolume(group: 'music' | 'sfx' | 'ui' | 'voice', vol: number): void",
        "mute": "Audio.mute(group?: string): void",
        "unmute": "Audio.unmute(group?: string): void"
      },
      "PlayOptions": {
        "volume": "number 0\u20131",
        "loop": "boolean",
        "spatial": "boolean",
        "position": "{ x: number, y: number }",
        "fade": "number \u2014 fade-in seconds",
        "rate": "number \u2014 playback speed multiplier"
      }
    },
    "Camera": {
      "import": "import { Camera } from '@emptysock/engine'",
      "methods": {
        "follow": "Camera.follow(entity: Entity, opts?: FollowOptions): void",
        "stopFollow": "Camera.stopFollow(): void",
        "shake": "Camera.shake(opts: { intensity: number, duration: number, decay?: 'linear' | 'exponential' }): void",
        "trauma": "Camera.trauma(amount: number): void",
        "zoom": "Camera.zoom(scale: number, opts?: TweenOptions): void",
        "flash": "Camera.flash(opts: { colour: number, duration: number }): void",
        "fade": "Camera.fade(opts: { to: number, duration: number }): void",
        "unfade": "Camera.unfade(opts?: { duration: number }): void",
        "letterbox": "Camera.letterbox(opts: { ratio: string }): void",
        "pillarbox": "Camera.pillarbox(opts: { ratio: string }): void"
      },
      "FollowOptions": {
        "lerp": "number 0\u20131",
        "deadzone": "{ x: number, y: number }",
        "lookahead": "{ x: number, y: number }",
        "bounds": "{ x: number, y: number, width: number, height: number }"
      }
    },
    "Timer": {
      "import": "import { Timer } from '@emptysock/engine'",
      "methods": {
        "after": "Timer.after(seconds: number, fn: () => void): TimerHandle",
        "every": "Timer.every(seconds: number, fn: () => void, opts?: { times?: number }): TimerHandle"
      },
      "TimerHandle": {
        "cancel": "handle.cancel(): void"
      }
    },
    "coroutines": {
      "import": "import { waitSeconds, waitFrames, waitUntil, waitForEvent, waitForAnimation, waitForDialogue, waitForPath } from '@emptysock/engine'",
      "usage": "entity.startCoroutine(function* name() { yield helper })",
      "helpers": {
        "waitSeconds": "yield waitSeconds(seconds: number)",
        "waitFrames": "yield waitFrames(count: number)",
        "waitUntil": "yield waitUntil(predicate: () => boolean)",
        "waitForEvent": "yield waitForEvent(eventName: string)",
        "waitForAnimation": "yield waitForAnimation(entity: Entity)",
        "waitForDialogue": "yield waitForDialogue()",
        "waitForPath": "yield waitForPath(entity: Entity)"
      }
    },
    "Tween": {
      "import": "import { Tween } from '@emptysock/engine'",
      "methods": {
        "to": "Tween.to(target: object, props: object, opts: TweenOptions): TweenHandle",
        "from": "Tween.from(target: object, props: object, opts: TweenOptions): TweenHandle",
        "sequence": "Tween.sequence(tweens: TweenHandle[]): TweenHandle"
      },
      "TweenOptions": {
        "duration": "number \u2014 seconds",
        "ease": "string \u2014 see easings list",
        "delay": "number \u2014 seconds",
        "loop": "boolean",
        "yoyo": "boolean",
        "onComplete": "() => void"
      },
      "easings": [
        "linear",
        "sineIn",
        "sineOut",
        "sineInOut",
        "quadIn",
        "quadOut",
        "quadInOut",
        "cubicIn",
        "cubicOut",
        "cubicInOut",
        "bounceOut",
        "bounceIn",
        "elasticOut",
        "backOut",
        "backIn"
      ]
    },
    "SaveSystem": {
      "import": "import { SaveSystem } from '@emptysock/engine'",
      "methods": {
        "save": "SaveSystem.save(slot: string, data: unknown): Promise<void>",
        "load": "SaveSystem.load(slot: string): Promise<SaveSlot>",
        "delete": "SaveSystem.delete(slot: string): Promise<void>",
        "listSlots": "SaveSystem.listSlots(): Promise<SaveSlot[]>",
